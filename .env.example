PORT=3000
NODE_ENV=production

# Database Configuration
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=main_dc
DB_CONNECTION_LIMIT=10

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests
# Example for local development: http://localhost:4200,http://127.0.0.1:4200
# Example for production: https://thehappyhive.github.io,https://api.akhilkrishnang.com
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# API Key Configuration
# Comma-separated list of valid API keys for write operations (POST, PUT, DELETE)
# GET requests do not require authentication
API_KEYS=default-key,your-production-key
